[Unit]
Description=Virtual YubiKey USB gadget
Documentation=https://github.com/qpernil/virtual-yubikey
After=local-fs.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/sbin/virtual-yubikey --run-as per
Restart=on-failure
RestartSec=2s
KillMode=mixed
TimeoutStopSec=10s

[Install]
WantedBy=multi-user.target
